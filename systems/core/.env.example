DATABASE_URL="postgresql://postgres:postgres@localhost:5433/alpinebrick_core?schema=public"
PORT=4000

# Where image bytes live until a CDN provider is chosen (ADR-0002).
# Swapping providers means writing one AssetStoragePort adapter and changing
# these two values -- no database rows change.
ASSET_STORAGE_DIR=./var/assets
ASSET_PUBLIC_BASE_URL=http://localhost:4000/assets
