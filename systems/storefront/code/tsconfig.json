{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "skipLibCheck": true,
    // vite/client declares import.meta.env, which lib/images.ts reads for the
    // asset base URL. Without it the tests still pass and the build fails.
    "types": ["vitest/globals", "@testing-library/jest-dom", "vite/client"]
  },
  // Only application source. vite.config.ts and vitest.config.ts are executed
  // by the bundler, not part of the app's type graph — and including them makes
  // tsc compare the workspace-hoisted vite against the local one, which are
  // different installs with structurally incompatible Plugin types.
  "include": ["src"]
}
